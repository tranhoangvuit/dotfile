[
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      ", t": "workspace::NewCenterTerminal",
      "; f": "file_finder::Toggle",
      "; t": "workspace::ToggleBottomDock",
      "; r": "workspace::NewSearch",
      ", e": "pane::RevealInProjectPanel",
      ", 1": ["pane::ActivateItem", 0],
      ", 2": ["pane::ActivateItem", 1],
      ", 3": ["pane::ActivateItem", 2],
      ", 4": ["pane::ActivateItem", 3],
      ", 5": ["pane::ActivateItem", 4],
      ", 6": ["pane::ActivateItem", 5],

      // AI
      ", a c": "agent::ToggleFocus",
      ", a i": "assistant::InlineAssist"
    }
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      // Git
      ", g b l": "editor::ToggleGitBlameInline",

      // AI
      ", a c": "assistant::Assist",
      ", a i": "assistant::InlineAssist",

      // LSP
      "g d": "editor::GoToDefinition",
      "g I": "editor::GoToImplementation",
      "g t": "editor::GoToTypeDefinition",
      "g r": "editor::FindAllReferences",

      // Symbol search
      "s s": "outline::Toggle",

      // Editor
      ", r n": "editor::Rename",

      // Navigator
      "s l": "workspace::ActivatePaneRight",
      "s h": "workspace::ActivatePaneLeft",
      "s k": "workspace::ActivatePaneUp",
      "s j": "workspace::ActivatePaneDown"
    }
  },
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !VimObject",
    "bindings": {
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-t": "workspace::NewTerminal",
      "ctrl-q": "pane::CloseActiveItem",
      "ctrl-e": "editor::ToggleFocus"
    }
  },
  {
    "context": "FileFinder",
    "bindings": {
      "ctrl-k": "menu::SelectPrevious",
      "ctrl-j": "menu::SelectNext"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      ", e": "workspace::CloseActiveDock",
      ", g": "git_panel::ToggleFocus",
      ", o": "outline_panel::ToggleFocus"
    }
  }
]
