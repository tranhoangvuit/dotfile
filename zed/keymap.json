[
	{
		"context": "VimControl && !menu",
		"bindings": {
			"; f": "file_finder::Toggle",
			"; g": "pane::DeploySearch",
			"; ;": "vim::RepeatFind",
			"space t n": "pane::ActivateNextItem",
			"space t p": "pane::ActivatePreviousItem",
			"space t t": "workspace::NewCenterTerminal",
			"space x x": "diagnostics::Deploy",
			"space r n": "editor::Rename",
			"space q": "pane::CloseActiveItem",
			"space w": "workspace::Save",
			"space g b": "git::Branch",
			"space g g": "git_panel::ToggleFocus",
			"space a a": "agent::ToggleFocus",
			"space a n": "agent::NewThread",
			"space a m": "agent::ToggleNewThreadMenu",
			"space a h": "agents_sidebar::ToggleThreadHistory",
			"ctrl-w up": "vim::ResizePaneUp",
			"ctrl-w down": "vim::ResizePaneDown",
		},
	},
	{
		"context": "vim_mode == visual",
		"bindings": {
			"ctrl-l": "agent::AddSelectionToThread",
		},
	},
	{
		"context": "Workspace",
		"bindings": {
			"; t": "workspace::ToggleBottomDock",
			"; e": "workspace::ToggleLeftDock",
			"; r": "workspace::ToggleRightDock",
			"; b": "tab_switcher::Toggle",
			"; a": "multi_workspace::ToggleWorkspaceSidebar",
			"; s": "multi_workspace::FocusWorkspaceSidebar",
			"; w": "git::Worktree",
		},
	},
	{
		"context": "ThreadsSidebar && not_searching",
		"bindings": {
			"j": "menu::SelectNext",
			"k": "menu::SelectPrevious",
			"h": "menu::SelectParent",
			"l": "menu::SelectChild",
			"g g": "menu::SelectFirst",
			"shift-g": "menu::SelectLast",
			"o": "menu::Confirm",
			"a": "agents_sidebar::NewThreadInGroup",
			"d": "agent::ArchiveSelectedThread",
			"shift-d": "agent::RemoveSelectedThread",
			"shift-h": "agents_sidebar::ToggleThreadHistory",
			"/": "agents_sidebar::FocusSidebarFilter",
			"q": "multi_workspace::ToggleWorkspaceSidebar",
		},
	},
	{
		"context": "Terminal && !AgentPanel",
		"bindings": {
			"ctrl-space": "workspace::ToggleBottomDock",
			"ctrl-o": "workspace::NewTerminal",
			"ctrl-n": "pane::ActivateNextItem",
			"ctrl-p": "pane::ActivatePreviousItem",
			"ctrl-q": "pane::CloseActiveItem",
			"ctrl-w j": "workspace::ActivatePaneDown",
			"ctrl-w k": "workspace::ActivatePaneUp",
			"ctrl-w h": "workspace::ActivatePaneLeft",
			"ctrl-w l": "workspace::ActivatePaneRight",
			"ctrl-w up": "vim::ResizePaneUp",
			"ctrl-w down": "vim::ResizePaneDown",
		},
	},
	{
		"context": "ProjectPanel && not_editing",
		"bindings": {
			"a": "project_panel::NewFile",
			"A": "project_panel::NewDirectory",
			"r": "project_panel::Rename",
			"d": "project_panel::Delete",
			"c": "project_panel::Copy",
			"p": "project_panel::Paste",
		},
	},
]
